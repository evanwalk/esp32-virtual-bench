; Engine configuration file.
; Generated/maintained by hand: the project is built headless in CI, so nothing here
; depends on editor-only state.

config_version=5

[application]

config/name="ESP32 Virtual Bench"
config/description="Pre-flight simulator for ESP32 circuits on a virtual breadboard, for Quest 3."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.055, 0.062, 0.078, 1)
boot_splash/show_image=false

[audio]

driver/enable_input=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[input]

trigger={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":10,"pressure":0.0,"pressed":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
grip={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":4,"pressure":0.0,"pressed":false,"script":null)
]
}
cycle_scenario={
"deadzone": 0.2,
"events": [Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":2,"pressure":0.0,"pressed":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":78,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=1
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.055, 0.062, 0.078, 1)

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/foveation_level=2
openxr/environment_blend_mode=0
shaders/enabled=true
